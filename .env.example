# ==============================================================================
# 반도체 인과 온톨로지 지식 위키 (Ontology Wiki) 환경 설정 템플릿
# ==============================================================================

# [1] 시스템 기본 설정
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

# [2] 인프라 스토리지 엔진 설정
# DB_ENGINE: "postgres" (기본 컨테이너) | "sqlite" (로컬 무설치 임베디드 폴백)
DB_ENGINE=postgres

# PostgreSQL 16 접속 정보
POSTGRES_USER=ontology_user
POSTGRES_PASSWORD=ontology_secure_pass
POSTGRES_DB=ontology_wiki
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ontology_user:ontology_secure_pass@localhost:5432/ontology_wiki

# SQLite 임베디드 로컬 폴백 (DB_ENGINE=sqlite 설정 시 활성화)
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./data/ontology_wiki.db

# [3] L2 캐시 및 동시성 제어 (Redis 7.2)
# USE_IN_MEMORY_REDIS: true 설정 시 별도 Redis 서버 없이 Python 인메모리 캐시/분산락 모의 구동
USE_IN_MEMORY_REDIS=false
REDIS_PORT=6379
REDIS_PASSWORD=ontology_redis_pass
REDIS_URL=redis://:ontology_redis_pass@localhost:6379/0

# [4] 온톨로지 거버넌스 & 지식 기준 판본
ACTIVE_VERSION=v1.2
LATEST_VERSION=v1.3
GAP_THRESHOLD=0.35
CACHE_TTL_CONCEPT_SECONDS=86400
PRESENCE_LOCK_TTL_SECONDS=30

# [5] AI 인과 추론 엔진 & LLM Gateway
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIME_SECONDS=30

# [6] 3단계 시스템 상태 인디케이터 표준 규격
# 🟢 healthy: 정상 가동 (모든 서비스 & AI 게이트웨이 정상)
# 🟡 degraded: 성능 저하 모드 (AI 오프라인, L1/L2 캐시 및 온톨로지 정적 룰베이스 폴백 가동 중)
# ⚫ maintenance: 계획된 점검 및 안전 정지 (불안감을 유발하는 빨간색 대신 차분한 검은색으로 표시)
