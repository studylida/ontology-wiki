# Copy locally or generate with scripts/v2/init_dev_env.py. Never commit real values.
OW_DEV_DB_PASSWORD=replace-with-random-url-safe-value
OW_DATABASE_URL=postgresql+asyncpg://ontology_dev:replace-with-random-url-safe-value@127.0.0.1:55432/ontology_wiki_dev
OW_AUTH_SECRET=replace-with-at-least-32-random-characters
OW_STORAGE_PATH=./var/raw
OW_RESEARCH_NETWORK_MODE=system
# disabled: honest configuration error; fixture: clearly labelled mechanics tests;
# live: configured OpenAI API. No silent fallback between modes.
OW_PROVIDER_MODE=disabled
OPENAI_API_KEY=
OW_GENERATION_MODEL=gpt-6-luna
OW_GENERATION_EFFORT=medium
OW_EMBEDDING_MODEL=text-embedding-3-large
OW_EMBEDDING_DIMENSIONS=1536
OW_EMBEDDING_API_DIMENSIONS=1536
OW_EMBEDDING_TRANSFORM=native
OW_INDEX_TIMEZONE=Asia/Seoul
OW_INDEX_HOUR_LOCAL=3
OW_AUTO_WIKI_DEFAULT=true
# Initial assumptions, not measured quality/latency guarantees:
OW_EXTENDED_MAX_QUERIES=3
OW_EXTENDED_SECONDS=15
OW_CONTEXT_MAX_CHARACTERS=24000
